{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2020",
    "module": "preserve",
    "moduleDetection": "legacy",
    "strict": false,
    "types": ["google-apps-script"],
    "skipLibCheck": true
  },
  "include": ["src/*.js", "src/*.d.ts"]
}
