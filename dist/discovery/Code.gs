const Template = {
  START: ['Step', 'Status / link', 'What to do'],
  PREVIEW: ['Section', 'Content'],
  DASHBOARD: ['Measure', 'Value', 'Reading this correctly'],

  setup() {
    Settings.initialize();
    Book.sheet('Backlog', Backlog.HEADERS);
    const demo = Book.sheet('Demo backlog', Backlog.HEADERS);
    if (demo.getLastRow() === 1) Book.append('Demo backlog', Backlog.HEADERS, Demo.rows());
    Book.sheet('Ranked', Backlog.OUTPUT);
    Book.sheet('Issues', Backlog.ISSUES);
    Book.sheet('Report preview', Template.PREVIEW);
    Book.sheet('Run log', RunLog.HEADERS);
    Book.sheet('Dashboard', Template.DASHBOARD);
    ['Backlog', 'Demo backlog'].forEach(Template.inputs);
    const result = Template.refresh(false);
    Book.open().setActiveSheet(Book.sheet('Start here', Template.START));
    return { summary: 'Setup complete. Demo and your own backlog are kept separately. ' + result.summary };
  },

  style(sh, input) {
    const cols = sh.getLastColumn();
    sh.setFrozenRows(1);
    sh.setTabColor(input ? '#0eaaa4' : '#15213d');
    sh.getRange(1, 1, 1, cols).setBackground('#15213d').setFontColor('#ffffff').setFontWeight('bold').setWrap(true);
    sh.setRowHeight(1, 42);
    sh.setColumnWidths(1, cols, 145);
    sh.getRange(1, 1, Math.max(2, sh.getLastRow()), cols).setFontFamily('Arial').setVerticalAlignment('top');
    if (!input) {
      const description = 'Generated by General Automation; edit source tabs instead.';
      if (!sh.getProtections(SpreadsheetApp.ProtectionType.SHEET).some(p => p.getDescription() === description)) {
        sh.protect().setDescription(description).setWarningOnly(true);
      }
    }
  },

  inputs(name) {
    const sh = Book.sheet(name, Backlog.HEADERS);
    Book.ensureRows(sh, Book.MAX_ROWS + 1);
    Template.style(sh, true);
    sh.setColumnWidth(2, 320);
    sh.setColumnWidth(16, 360);
    sh.getRange(2, 1, Book.MAX_ROWS, Backlog.HEADERS.length - 1).setBackground('#fff8e6');
    const bounds = { 4: [0, 100000], 5: [0, 10080], 6: [1, 10000], 7: [0, 100], 8: [0, 10080], 11: [0, 100], 12: [0.01, 100000], 14: [0, 100000], 17: [0, 10080] };
    Object.keys(bounds).forEach(c => sh.getRange(2, Number(c), Book.MAX_ROWS, 1).setDataValidation(
      SpreadsheetApp.newDataValidation().requireNumberBetween(bounds[c][0], bounds[c][1]).setAllowInvalid(false).build()));
    [9, 10, 13].forEach(c => sh.getRange(2, c, Book.MAX_ROWS, 1).setDataValidation(
      SpreadsheetApp.newDataValidation().requireValueInList(c === 13 ? ['Planned', 'In progress', 'Live', 'Paused'] : ['Yes', 'No', 'Unsure'], true).setAllowInvalid(false).build()));
    sh.getRange(2, 15, Book.MAX_ROWS, 1).setNumberFormat('yyyy-mm-dd');
    const notes = {
      4: 'How many times the whole process runs each week.',
      5: 'Minutes each participating person spends per run; exclude rework.',
      6: 'People spending the minutes above on each run. Blank means 1.',
      7: 'Share of runs needing rework, from 0 to 100. Enter 10 for 10%; no % sign.',
      8: 'Total team minutes per failed run; do not multiply this by people again.',
      9: 'Does anyone need this output? No recommends deleting the work. Unsure excludes its savings until discovery.',
      10: 'Should the process be simplified before building automation?',
      11: 'Share of current effort that could be removed, 0 to 100. Blank assumes 80. Zero keeps it manual.',
      12: 'Total implementation effort, including training and handoff. Blank uses Settings and is flagged as assumed.',
      14: 'Observed weekly savings after launch; blank means not measured. Zero means measured with no saving. Requires Live and Measured on.',
      17: 'Weekly maintenance and monitoring time after launch. Deducted from potential savings. Blank means zero.',
      18: 'Use the same group when two rows count the same staff time. Every row in a repeated group is held in Issues until reconciled.',
      19: 'Managed submission identifier. Keep it with the row when sorting; leave blank for manual rows. Imported rows removed from Backlog will return on the next import.',
    };
    Object.keys(notes).forEach(c => sh.getRange(1, Number(c)).setNote(notes[c]));
  },

  refresh(importForm) {
    const opts = Settings.read();
    const imported = importForm && opts.source === 'My backlog' && opts.files ? Intake.sync() : 0;
    const source = opts.source === 'Demo' ? 'Demo backlog' : 'Backlog';
    const result = Backlog.evaluate(Book.read(source, Backlog.HEADERS), opts, source);
    Book.replace('Issues', Backlog.ISSUES, result.issues);
    const ranked = Book.replace('Ranked', Backlog.OUTPUT, result.ranked.map(Backlog.toRow));
    Template.style(ranked, false);
    ranked.setColumnWidth(3, 320);
    ranked.setColumnWidth(13, 360);
    if (result.ranked.length) {
      ranked.getRange(2, 6, result.ranked.length, 6).setNumberFormat('0.00');
      ranked.getRange(2, 12, result.ranked.length, 1).setNumberFormat('yyyy-mm-dd');
    }
    Template.dashboard(result, opts);
    Report.preview(result, opts);
    Template.start(result, opts);
    ['Issues', 'Report preview', 'Run log', 'Settings', 'Start here'].forEach(name => Template.style(Book.open().getSheetByName(name), name === 'Settings'));
    Book.open().getSheetByName('Start here').setColumnWidth(3, 650);
    Book.open().getSheetByName('Report preview').setColumnWidth(2, 900);
    Book.open().getSheetByName('Report preview').getDataRange().setWrap(true);
    Book.open().getSheetByName('Settings').setColumnWidth(1, 220);
    Book.open().getSheetByName('Settings').setColumnWidth(3, 650);
    result.summary = source + ': ' + result.ranked.length + ' valid rows; ' + result.issues.length + ' rows to fix; ' + imported + ' submissions imported.';
    return result;
  },

  start(result, opts) {
    const formId = Book.state('formId');
    const reportId = Book.state('reportId');
    Book.replace('Start here', Template.START, [
      ['1. Try the demo', opts.source === 'Demo' ? 'DEMO — fictional data' : 'MY BACKLOG — your data', 'Automations → Rank my backlog. Read Ranked, Dashboard, and Report preview.'],
      ['2. Set your assumptions', 'Settings', 'Change the yellow values. Potential savings are estimates; annual value is capacity, not cash.'],
      ['3. Add your own work', 'Backlog', 'Choose My backlog in Settings. Fill in the yellow columns or use the optional intake Form. Keep each process unique; avoid overlapping hours.'],
      ['4. Optional Google files', opts.files ? 'Enabled' : 'Preview mode — no Form or Doc creation', 'Set Create Google files to Yes only when ready. Menu actions ask before creating files. Google may require consent for Forms and Docs.'],
      ['5. Collect submissions', formId ? 'https://docs.google.com/forms/d/' + formId + '/edit' : 'Not created', 'Automations → Create intake form. Review its questions, publish it in Google Forms, and choose who may respond. Rank my backlog imports new responses.'],
      ['6. Fix incomplete rows', result.issues.length ? result.issues.length + ' rows need attention' : 'No row errors', 'Issues names the source row and what to fix. Edit the source row and rank again. Invalid rows are excluded from totals and the report says so.'],
      ['7. Share the discovery brief', reportId ? 'https://docs.google.com/document/d/' + reportId + '/edit' : 'Preview is ready', 'Read Report preview. Automations → Make discovery report creates or refreshes one dedicated Doc. Share it yourself.'],
      ['8. Measure after launch', 'Backlog → Status, Measured hours/week saved, Measured on', 'Enter observed weekly savings only after launch. Set Status to Live and record the measurement date. The chart keeps estimates and observations separate.'],
      ['Need help?', 'Automations → Fix setup problems', 'Read the operator guide in the GitHub repository. No script editor is needed after installation.'],
    ]);
  },

  dashboard(result, opts) {
    const sh = Book.replace('Dashboard', Template.DASHBOARD, [
      ['Data shown', opts.source === 'Demo' ? 'DEMO — all values fictional' : 'My backlog', 'Last ranked: ' + new Date().toISOString()],
      ['Current hours/week', '', 'Baseline includes rework; overlap between processes must be removed by the operator.'],
      ['Potential hours/week', '', 'Estimated removable work, including processes already live; not additional savings.'],
      ['Measured hours/week', '', 'Observed savings only. Blank source values are not measured, not zero.'],
      ['Valid processes', '', 'Invalid rows are listed in Issues and excluded.'],
      ['Rows to fix', result.issues.length, 'Correct source rows, then rank again.'],
      ['Annual capacity value', '', 'Potential hours × working weeks × hourly cost. Not a forecast of cash savings.'],
      ['Comparison below', 'First 10 ranked processes', 'Bars compare potential and measured weekly hours per process. Missing measurement is blank.'],
    ]);
    sh.getRange('B3').setFormula('=SUM(Ranked!F2:F2001)');
    sh.getRange('B4').setFormula('=SUM(Ranked!G2:G2001)');
    sh.getRange('B5').setFormula('=IF(COUNT(Ranked!K2:K2001)=0,"Not measured",SUM(Ranked!K2:K2001))');
    sh.getRange('B6').setFormula('=COUNTA(Ranked!C2:C2001)');
    sh.getRange('B8').setFormula('=SUM(Ranked!J2:J2001)');
    sh.getRange('B3:B5').setNumberFormat('0.00');
    sh.getRange('B8').setNumberFormat('#,##0.00');
    sh.getRange('A12:C23').clearContent();
    sh.getRange('A12').setFormula('=IFERROR(QUERY(Ranked!A1:K2001,"select C,G,K where C is not null limit 10 label C \'Process\', G \'Potential hours/week\', K \'Measured hours/week\'",1),"No valid processes yet")');
    sh.getCharts().forEach(chart => sh.removeChart(chart));
    if (result.ranked.length) sh.insertChart(sh.newChart().setChartType(Charts.ChartType.BAR).addRange(sh.getRange('A12:C22')).setNumHeaders(1)
      .setPosition(12, 5, 0, 0).setOption('title', (opts.source === 'Demo' ? 'DEMO: ' : '') + 'Potential vs. measured hours/week')
      .setOption('colors', ['#0eaaa4', '#15213d']).setOption('width', 800).setOption('height', 440).build());
    Template.style(sh, false);
    sh.setColumnWidth(1, 370);
    sh.setColumnWidth(3, 650);
    sh.getRange('A1:C9').setWrap(true);
  },

  doctor() {
    const opts = Settings.read();
    const expected = { 'Backlog': Backlog.HEADERS, 'Demo backlog': Backlog.HEADERS, 'Ranked': Backlog.OUTPUT,
      'Settings': Settings.HEADERS, 'Issues': Backlog.ISSUES, 'Run log': RunLog.HEADERS, 'Start here': Template.START, 'Report preview': Template.PREVIEW, 'Dashboard': Template.DASHBOARD };
    const missing = Object.keys(expected).filter(name => !Book.open().getSheetByName(name));
    if (missing.length) throw new OperatorError('Missing tabs: ' + missing.join(', ') + '. Run Set up workbook to restore missing tabs.');
    Object.keys(expected).forEach(name => Book.sheet(name, expected[name]));
    if (opts.files && Book.state('formId')) {
      const form = Intake.open();
      if (Book.state('formReady') !== 'yes') throw new OperatorError('Form setup was interrupted. Run Create intake form again to finish it.');
      Intake.validate(form);
    }
    const result = Template.refresh(false);
    return { summary: result.summary + ' Setup checks passed.' };
  },
};

const Intake = {
  FIELDS: [
    { title: 'Department', max: 100 },
    { title: 'Process', max: 160, help: 'Describe one process, with a clear start and finish.' },
    { title: 'Owner', max: 100, help: 'Who can verify the steps and baseline? A team role is fine.' },
    { title: 'Runs/week', min: 0, max: 100000 },
    { title: 'Minutes/run', min: 0, max: 10080, help: 'Minutes per person per run, excluding rework.' },
    { title: 'People/run', min: 1, max: 10000, optional: true, help: 'Blank means one person.' },
    { title: 'Error rate %', min: 0, max: 100, optional: true, help: 'Enter 10 for 10%. Blank means zero.' },
    { title: 'Rework min/error', min: 0, max: 10080, optional: true, help: 'Total team minutes per failed run. Blank means zero.' },
    { title: 'Needed?', choices: ['Yes', 'No', 'Unsure'], help: 'Does anyone use or require the output?' },
    { title: 'Redesign first?', choices: ['Yes', 'No', 'Unsure'], help: 'Could the steps be simplified before automating?' },
    { title: 'Automatable %', min: 0, max: 100, optional: true, help: 'Estimated share removable. Blank assumes 80%; use zero to keep manual.' },
    { title: 'Build hours', min: 0.01, max: 100000, optional: true, help: 'Include rollout and training. Blank uses the workbook default.' },
    { title: 'Notes', max: 1000, optional: true, help: 'Dependencies, current tools, or why the work might be unnecessary. Do not include credentials or customer data.' },
    { title: 'Upkeep min/week', min: 0, max: 10080, optional: true, help: 'Expected weekly monitoring and maintenance after launch. Blank means zero; this is deducted from potential savings.' },
    { title: 'Overlap group', max: 100, optional: true, help: 'Use the same short name for processes that count the same staff time, including across teams. The owner must reconcile them before their savings are counted.' },
  ],

  open() {
    const id = Book.state('formId');
    if (!id) return null;
    try { return FormApp.openById(id); }
    catch (_) { throw new OperatorError('The intake Form is unavailable. Ask its creator to restore it or grant you access. Setup will not create a duplicate.'); }
  },

  validate(form) {
    const items = form.getItems();
    if (items.length > Intake.FIELDS.length || items.some((item, i) => (item.getTitle() !== Intake.FIELDS[i].title && !(Book.state('formReady') !== 'yes' && item.getTitle() === '')) ||
      item.getType() !== (Intake.FIELDS[i].choices ? FormApp.ItemType.MULTIPLE_CHOICE : FormApp.ItemType.TEXT))) {
      throw new OperatorError('The intake Form questions changed. Restore the original question titles, order, and types before importing. Existing submissions have been kept.');
    }
    return items.length;
  },

  create() {
    Settings.requireFiles();
    let form = Intake.open();
    if (!form) {
      form = FormApp.create('Automation Discovery — ' + Book.open().getName(), false);
      Book.state('formId', form.getId());
    }
    Intake.validate(form);
    if (Book.state('formReady') !== 'yes') Intake.FIELDS.forEach((field, index) => {
      const existing = form.getItems()[index];
      const item = existing ? (field.choices ? existing.asMultipleChoiceItem() : existing.asTextItem()) : field.choices ? form.addMultipleChoiceItem() : form.addTextItem();
      if (field.choices) /** @type {GoogleAppsScript.Forms.MultipleChoiceItem} */ (item).setChoiceValues(field.choices);
      item.setTitle(field.title).setRequired(!field.optional).setHelpText(field.help || '');
      if (!field.choices) {
        const validation = FormApp.createTextValidation();
        if (field.min !== undefined) validation.requireNumberBetween(field.min, field.max);
        else validation.requireTextLengthLessThanOrEqualTo(field.max);
        /** @type {GoogleAppsScript.Forms.TextItem} */ (item).setValidation(validation.setHelpText(field.min !== undefined ? 'Enter a number from ' + field.min + ' to ' + field.max + '.' : 'Use at most ' + field.max + ' characters.').build());
      }
    });
    form.setDescription('Tell us about repetitive work. Submit one process at a time. Estimates are fine; choose Unsure when the purpose or design needs discovery. Never enter passwords, tokens, or customer records.')
      .setConfirmationMessage('Saved. The workbook owner will import submissions when they choose Rank my backlog.')
      .setCollectEmail(false).setAllowResponseEdits(false).setPublishingSummary(false);
    Book.state('formReady', 'yes');
    Template.refresh(false);
    return { summary: 'Intake Form is ready. Open its link in Start here, review access, and publish it in Google Forms. Re-running this action reuses the same Form.' };
  },

  plan(responses, existingRows) {
    const ids = new Set(existingRows.map(row => row[18]).filter(Boolean));
    const rows = [];
    responses.forEach(response => {
      const id = response.getId();
      if (typeof id !== 'string' || !id || id.length > 180) throw new OperatorError('A Form submission has an invalid identifier. Open the Form responses before retrying.');
      const source = 'form:' + id;
      if (ids.has(source)) return;
      const answers = {};
      response.getItemResponses().forEach(answer => {
        const title = answer.getItem().getTitle();
        if (!Intake.FIELDS.some(field => field.title === title) || Object.prototype.hasOwnProperty.call(answers, title)) {
          throw new OperatorError('A submission uses unexpected questions. Restore the Form questions before importing.');
        }
        const value = answer.getResponse();
        if (typeof value !== 'string' || value.length > 1000) throw new OperatorError('A submission contains unexpected or oversized data. Review it in Google Forms.');
        answers[title] = value;
      });
      answers.Status = 'Planned';
      answers['Source ID'] = source;
      rows.push(Backlog.HEADERS.map(title => answers[title] === undefined ? '' : answers[title]));
      ids.add(source);
    });
    if (existingRows.length + rows.length > Book.MAX_ROWS) throw new OperatorError('Import would exceed 2,000 Backlog rows. Archive older submissions first; none were imported.');
    return rows;
  },

  sync() {
    Settings.requireFiles();
    const form = Intake.open();
    if (!form) return 0;
    if (Book.state('formReady') !== 'yes' || Intake.validate(form) !== Intake.FIELDS.length) throw new OperatorError('Intake setup is incomplete. Run Create intake form again.');
    const responses = form.getResponses();
    if (responses.length > Book.MAX_ROWS) throw new OperatorError('The intake Form exceeds 2,000 submissions. Start a fresh Discovery workbook and Form for the next intake period.');
    const rows = Intake.plan(responses, Book.read('Backlog', Backlog.HEADERS));
    Book.append('Backlog', Backlog.HEADERS, rows);
    return rows.length;
  },
};

const Report = {
  lines(result, opts) {
    const s = Backlog.summarize(result.ranked);
    const n = value => value.toFixed(1);
    const lines = [
      ['Automation Discovery Brief', opts.source === 'Demo' ? 'DEMO — entirely fictional data' : 'Operational discovery — ' + Book.open().getName()],
      ['Baseline', s.count + ' valid processes; ' + n(s.current) + ' staff hours/week including rework.'],
      ['Potential', n(s.potential) + ' hours/week removable; annual capacity value ' + Math.round(s.annual).toLocaleString('en-US') + ' in your configured currency. Includes work already live.'],
      ['Observed', s.measured === null ? 'Not measured yet.' : n(s.measured) + ' hours/week measured across ' + s.measuredCount + ' live processes; all other processes remain unmeasured.'],
      ['Coverage', result.issues.length + ' invalid rows excluded. Check Issues before acting on this brief. Confirm that process baselines do not overlap.'],
      ['Assumptions', opts.weeksPerYear + ' working weeks/year; cost ' + opts.hourlyCost + '/hour; blank effort uses ' + opts.defaultBuildHours + 'h (' + opts.deleteHours + 'h to delete). Capacity value is not cash savings.'],
    ];
    s.top.forEach((r, i) => lines.push(['Next ' + (i + 1), r.action + ': ' + r.process + ' [' + r.department + ']. Owner: ' + r.owner + '. Potential ' + n(r.saved) + 'h/week; effort ' + n(r.build) + 'h; payback ' + n(r.payback) + ' weeks.' + (r.assumptions ? ' ' + r.assumptions + '.' : '')]));
    if (!s.top.length) lines.push(['Next steps', 'No unlaunched positive-saving candidates. Review unclear processes and collect a baseline.']);
    lines.push(['Before building', 'Verify the baseline with each owner. Group overlapping work and reconcile it; simplify inputs and handoffs before writing scripts. Weekly upkeep is deducted when supplied; blank upkeep assumes zero.']);
    return lines;
  },

  preview(result, opts) {
    return Book.replace('Report preview', Template.PREVIEW, Report.lines(result, opts));
  },

  create() {
    const opts = Settings.requireFiles();
    const result = Template.refresh(true);
    if (result.issues.length) throw new OperatorError('Fix the rows listed in Issues before creating a shareable report. The preview has been refreshed.');
    if (!result.ranked.length) throw new OperatorError('Add at least one valid process to Backlog before creating a report.');
    const id = Book.state('reportId');
    let doc;
    if (id) {
      try { doc = DocumentApp.openById(id); }
      catch (_) { throw new OperatorError('The discovery report is unavailable. Ask its creator to restore it or grant access. A second report was not created.'); }
    } else {
      doc = DocumentApp.create('Automation Discovery Brief — ' + Book.open().getName());
      Book.state('reportId', doc.getId());
    }
    const lines = Report.lines(result, opts);
    const body = doc.getBody();
    // This dedicated generated Doc is rebuilt after interruptions; the preview remains intact.
    body.clear();
    body.setMarginTop(36).setMarginBottom(36).setMarginLeft(42).setMarginRight(42);
    body.editAsText().setFontFamily('Arial').setFontSize(10);
    lines.forEach((row, i) => {
      const p = body.appendParagraph(row[0] + (i === 0 ? '\n' : ': ') + row[1]);
      p.setSpacingAfter(7);
      if (i === 0) p.setHeading(DocumentApp.ParagraphHeading.HEADING1);
    });
    doc.saveAndClose();
    Template.start(result, opts);
    return { summary: 'Discovery report refreshed. Open its link in Start here. Re-running refreshes the same dedicated Doc.' };
  },
};

function onOpen() {
  SpreadsheetApp.getUi().createMenu('Automations')
    .addItem('Set up workbook', 'setupWorkbook')
    .addItem('Rank my backlog', 'rankBacklog')
    .addSeparator()
    .addItem('Create intake form', 'createIntakeForm')
    .addItem('Make discovery report', 'makeDiscoveryReport')
    .addSeparator()
    .addItem('Fix setup problems', 'checkSetup')
    .addToUi();
}

function operatorAction_(name, fn) {
  try {
    const result = RunLog.run(name, fn);
    Book.open().toast(result.summary, 'Automations', 10);
    return result;
  } catch (error) {
    const message = error instanceof OperatorError ? error.message :
      'This action could not finish. Check your Google permissions and workbook access, then choose Fix setup problems. If it persists, ask the workbook owner to inspect Apps Script → Executions.';
    SpreadsheetApp.getUi().alert('Automations needs attention', message, SpreadsheetApp.getUi().ButtonSet.OK);
    return { error: message };
  }
}

function setupWorkbook() { return operatorAction_('Set up workbook', Template.setup); }
function rankBacklog() { return operatorAction_('Rank my backlog', () => Template.refresh(true)); }
function checkSetup() { return operatorAction_('Fix setup problems', Template.doctor); }

function createIntakeForm() {
  const ui = SpreadsheetApp.getUi();
  if (ui.alert('Create intake form', 'This creates or finishes one Form in your Google account. It stays unpublished until you publish it yourself. Continue?', ui.ButtonSet.YES_NO) !== ui.Button.YES) return;
  return operatorAction_('Create intake form', Intake.create);
}

function makeDiscoveryReport() {
  const ui = SpreadsheetApp.getUi();
  if (ui.alert('Refresh discovery report', 'This creates or replaces the contents of the dedicated report Doc linked in Start here. Keep your own notes in a different Doc. Continue?', ui.ButtonSet.YES_NO) !== ui.Button.YES) return;
  return operatorAction_('Make discovery report', Report.create);
}
