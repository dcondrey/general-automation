// Generated by npm run build. Edit src/ instead.

class OperatorError extends Error {}

const Book = {
  MAX_ROWS: 2000,
  MAX_TEXT: 2000,

  open() {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    if (!ss) throw new OperatorError('Open the Discovery workbook and use its Automations menu.');
    return ss;
  },

  sheet(name, headers) {
    const ss = Book.open();
    let sh = ss.getSheetByName(name);
    if (!sh) sh = ss.insertSheet(name);
    if (headers) {
      if (sh.getLastRow() === 0) {
        Book.put(sh.getRange(1, 1, 1, headers.length), [headers]);
      } else {
        const actual = sh.getRange(1, 1, 1, Math.max(sh.getLastColumn(), headers.length)).getValues()[0];
        if (actual.length !== headers.length || actual.some((h, i) => h !== headers[i])) {
          throw new OperatorError('The column headings in "' + name + '" changed. Restore them from the operator guide before continuing; your rows have been kept.');
        }
      }
    }
    return sh;
  },

  safeCell(value) {
    if (typeof value === 'string') {
      if (value.length > Book.MAX_TEXT) throw new OperatorError('A text value exceeds 2,000 characters. Shorten it before continuing.');
      return /^[\s\u0000-\u001f]*[=+@\-]/.test(value) ? "'" + value : value;
    }
    return value === undefined || value === null ? '' : value;
  },

  put(range, rows) {
    range.setValues(rows.map(row => row.map(Book.safeCell)));
  },

  read(name, headers) {
    const sh = Book.sheet(name, headers);
    if (sh.getLastRow() > Book.MAX_ROWS + 1) throw new OperatorError('"' + name + '" exceeds 2,000 rows. Archive older rows in a separate workbook first.');
    return sh.getLastRow() < 2 ? [] : sh.getRange(2, 1, sh.getLastRow() - 1, headers.length).getValues();
  },

  replace(name, headers, rows) {
    if (rows.length > Book.MAX_ROWS) throw new OperatorError('This operation exceeds the 2,000-row limit.');
    const sh = Book.sheet(name, headers);
    const values = [headers].concat(rows).map(row => row.map(Book.safeCell));
    Book.ensureRows(sh, values.length);
    const previous = sh.getLastRow();
    sh.getRange(1, 1, values.length, headers.length).setValues(values);
    if (previous > values.length) sh.getRange(values.length + 1, 1, previous - values.length, headers.length).clearContent();
    return sh;
  },

  ensureRows(sh, count) {
    if (count > sh.getMaxRows()) sh.insertRowsAfter(sh.getMaxRows(), count - sh.getMaxRows());
  },

  append(name, headers, rows) {
    if (!rows.length) return;
    const sh = Book.sheet(name, headers);
    const end = sh.getLastRow() + rows.length;
    if (end > Book.MAX_ROWS + 1) throw new OperatorError('"' + name + '" would exceed 2,000 rows. Archive older rows first.');
    Book.ensureRows(sh, end);
    Book.put(sh.getRange(sh.getLastRow() + 1, 1, rows.length, headers.length), rows);
  },

  state(key, value) {
    const props = PropertiesService.getDocumentProperties();
    if (!props) throw new OperatorError('Install this script inside a Google spreadsheet.');
    // Copied containers must never reuse the original workbook's Form or Doc.
    const scoped = Book.open().getId() + ':' + key;
    if (value !== undefined) props.setProperty(scoped, String(value));
    return props.getProperty(scoped);
  },

  locked(fn) {
    const lock = LockService.getDocumentLock();
    if (!lock || !lock.tryLock(1000)) throw new OperatorError('Another automation is running. Wait a moment, then try again.');
    try { return fn(); } finally { lock.releaseLock(); }
  },
};

const RunLog = {
  HEADERS: ['Started', 'Action', 'Status', 'Seconds', 'What happened'],

  record(name, started, status, detail) {
    const sh = Book.sheet('Run log', RunLog.HEADERS);
    if (sh.getLastRow() > 501) sh.deleteRows(2, sh.getLastRow() - 501);
    Book.append('Run log', RunLog.HEADERS, [[new Date(started), name, status, (Date.now() - started) / 1000, detail.slice(0, 500)]]);
  },

  run(name, fn) {
    const started = Date.now();
    let result;
    try {
      result = Book.locked(fn);
    } catch (error) {
      try { Book.locked(() => RunLog.record(name, started, 'Needs attention', 'Action stopped. Use Fix setup problems and check Issues.')); }
      catch (_) { console.error('Could not record the failed action. Check workbook access.'); }
      throw error;
    }
    try { Book.locked(() => RunLog.record(name, started, 'Done', result && result.summary || 'Completed.')); }
    catch (_) {
      throw new OperatorError('The action completed, but the Run log could not be updated. Check the results before retrying; restore Run log headings if they changed.');
    }
    return result;
  },
};

function operatorAction_(name, fn) {
  try {
    const result = RunLog.run(name, fn);
    Book.open().toast(result.summary, 'Automations', 10);
    return result;
  } catch (error) {
    const message = error instanceof OperatorError ? error.message :
      'This action could not finish. Check Settings, Run log, Google permissions, and workbook access. If it persists, ask the workbook owner to inspect Apps Script → Executions.';
    SpreadsheetApp.getUi().alert('Automations needs attention', message, SpreadsheetApp.getUi().ButtonSet.OK);
    return { error: message };
  }
}

const Backlog = {
  HEADERS: ['Department', 'Process', 'Owner', 'Runs/week', 'Minutes/run', 'People/run', 'Error rate %', 'Rework min/error', 'Needed?', 'Redesign first?', 'Automatable %', 'Build hours', 'Status', 'Measured hours/week saved', 'Measured on', 'Notes', 'Upkeep min/week', 'Overlap group', 'Source ID'],
  OUTPUT: ['Rank', 'Department', 'Process', 'Owner', 'Recommendation', 'Current hours/week', 'Potential hours/week', 'Implementation hours', 'Payback weeks', 'Annual capacity value', 'Measured hours/week saved', 'Measured on', 'Assumptions', 'Backlog row', 'Source ID'],
  ISSUES: ['Sheet', 'Row', 'Process', 'What to fix'],

  number(value, label, min, max, fallback) {
    if (value === '' || value === null || value === undefined) {
      if (fallback !== undefined) return fallback;
      throw new OperatorError('Fill in ' + label + '.');
    }
    if ((typeof value !== 'number' && (typeof value !== 'string' || !/^\d+(\.\d+)?$/.test(value.trim()))) || !Number.isFinite(Number(value))) {
      throw new OperatorError(label + ' must be a number using a decimal point, without commas, units, or a % sign.');
    }
    const n = Number(value);
    if (n < min || n > max) throw new OperatorError(label + ' must be between ' + min + ' and ' + max + '.');
    return n;
  },

  text(value, label, max, optional) {
    if (typeof value !== 'string' || (!optional && !value.trim())) throw new OperatorError('Fill in ' + label + ' as text.');
    if (value.length > max) throw new OperatorError(label + ' must be at most ' + max + ' characters.');
    return value.trim();
  },

  choice(value, label, choices, fallback) {
    if ((value === '' || value === undefined) && fallback !== undefined) return fallback;
    if (!choices.includes(value)) throw new OperatorError('Choose ' + label + ' from: ' + choices.join(', ') + '.');
    return value;
  },

  item(row, rowNumber) {
    const item = {};
    Backlog.HEADERS.forEach((h, i) => { item[h] = row[i] === undefined ? '' : row[i]; });
    item.row = rowNumber;
    return item;
  },

  score(item, options) {
    const opts = Object.assign({ weeksPerYear: 48, hourlyCost: 45, defaultBuildHours: 8, deleteHours: 0.5 }, options);
    const department = Backlog.text(item.Department, 'Department', 100);
    const process = Backlog.text(item.Process, 'Process', 160);
    const owner = Backlog.text(item.Owner, 'Owner', 100);
    Backlog.text(item.Notes || '', 'Notes', 1000, true);
    const runs = Backlog.number(item['Runs/week'], 'Runs/week', 0, 100000);
    const minutes = Backlog.number(item['Minutes/run'], 'Minutes/run', 0, 10080);
    const people = Backlog.number(item['People/run'], 'People/run', 1, 10000, 1);
    const errors = Backlog.number(item['Error rate %'], 'Error rate %', 0, 100, 0) / 100;
    const rework = Backlog.number(item['Rework min/error'], 'Rework min/error', 0, 10080, 0);
    const needed = Backlog.choice(item['Needed?'], 'Needed?', ['Yes', 'No', 'Unsure']);
    const redesign = Backlog.choice(item['Redesign first?'], 'Redesign first?', ['Yes', 'No', 'Unsure']);
    const share = Backlog.number(item['Automatable %'], 'Automatable %', 0, 100, 80) / 100;
    const build = Backlog.number(item['Build hours'], 'Build hours', 0.01, 100000, needed === 'No' ? opts.deleteHours : opts.defaultBuildHours);
    const status = Backlog.choice(item.Status, 'Status', ['Planned', 'In progress', 'Live', 'Paused'], 'Planned');
    const upkeep = Backlog.number(item['Upkeep min/week'], 'Upkeep min/week', 0, 10080, 0) / 60;
    const overlap = Backlog.text(item['Overlap group'] || '', 'Overlap group', 100, true).toLowerCase();
    const hours = runs * (minutes * people + errors * rework) / 60;
    const unresolved = needed === 'Unsure' || (needed !== 'No' && redesign === 'Unsure');
    const gross = hours * (needed === 'No' ? 1 : share);
    const saved = unresolved ? null : Math.max(0, gross - upkeep);
    const action = needed === 'No' ? 'Delete' : unresolved ? 'Investigate' : saved === 0 ? 'Keep manual' : redesign === 'Yes' ? 'Redesign first' : 'Automate';
    let measured = null;
    let measuredOn = '';
    if (item['Measured hours/week saved'] !== '') {
      measured = Backlog.number(item['Measured hours/week saved'], 'Measured hours/week saved', 0, hours);
      if (status !== 'Live') throw new OperatorError('Set Status to Live before recording measured savings.');
      measuredOn = Backlog.date(item['Measured on']);
    } else if (item['Measured on'] !== '') {
      throw new OperatorError('Fill in Measured hours/week saved, or clear Measured on.');
    }
    const assumptions = [];
    if (item['Build hours'] === '') assumptions.push('Effort assumed: ' + build + 'h');
    if (needed !== 'No' && item['Automatable %'] === '') assumptions.push('Automatable assumed: 80%');
    if (unresolved) assumptions.push('Discovery needed; savings excluded');
    if (redesign === 'Yes' && needed !== 'No') assumptions.push('Potential only; validate after redesign');
    if (upkeep) assumptions.push('Upkeep deducted: ' + upkeep.toFixed(2) + 'h/week');
    if (upkeep >= gross && upkeep > 0) assumptions.push('No positive net saving');
    return { item, department, process, owner, hours, saved, build, action, status, measured, measuredOn, overlap,
      leverage: saved === null ? null : saved / build,
      payback: saved > 0 ? build / saved : null,
      annual: saved === null ? null : saved * opts.weeksPerYear * opts.hourlyCost,
      assumptions: assumptions.join('; ') };
  },

  date(value) {
    let d;
    if (value instanceof Date && Number.isFinite(value.getTime())) d = value;
    else if (typeof value === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(value)) {
      d = new Date(value + 'T12:00:00Z');
      if (!Number.isFinite(d.getTime()) || d.toISOString().slice(0, 10) !== value) d = null;
    }
    if (!d || d.toISOString().slice(0, 10) > new Date().toISOString().slice(0, 10)) throw new OperatorError('Enter a valid Measured on date (YYYY-MM-DD), no later than today.');
    return d;
  },

  evaluate(rows, options, sheet) {
    const ranked = [];
    const issues = [];
    const ids = new Set();
    rows.forEach((row, index) => {
      if (row.every(v => v === '' || v === null)) return;
      const item = Backlog.item(row, index + 2);
      try {
        const id = Backlog.text(item['Source ID'], 'Source ID', 200, true);
        if (id && ids.has(id)) throw new OperatorError('Source ID is duplicated. Keep one row per submission.');
        if (id) ids.add(id);
        ranked.push(Backlog.score(item, options));
      } catch (error) {
        issues.push([sheet, index + 2, String(item.Process).slice(0, 160), error.message]);
      }
    });
    const groups = new Map();
    ranked.filter(r => r.overlap).forEach(r => {
      const group = groups.get(r.overlap) || [];
      group.push(r);
      groups.set(r.overlap, group);
    });
    const collisions = new Set();
    groups.forEach(group => {
      if (group.length < 2) return;
      group.forEach(r => {
        collisions.add(r);
        issues.push([sheet, r.item.row, r.process, 'Overlap group "' + r.overlap + '" appears in rows ' + group.slice(0, 10).map(other => other.item.row).join(', ') + (group.length > 10 ? ' and ' + (group.length - 10) + ' more' : '') + '. Merge shared effort into one process, or use separate groups only if the baselines are independent. All rows in this group are excluded to prevent counting hours twice.']);
      });
    });
    const eligible = ranked.filter(r => !collisions.has(r));
    eligible.sort((a, b) => (b.leverage === null ? -1 : b.leverage) - (a.leverage === null ? -1 : a.leverage) || (b.saved || 0) - (a.saved || 0) || a.item.row - b.item.row);
    eligible.forEach((r, i) => { r.rank = i + 1; });
    return { ranked: eligible, issues, source: sheet, summary: '' };
  },

  toRow(r) {
    return [r.rank, r.department, r.process, r.owner, r.action, r.hours, r.saved, r.build, r.payback, r.annual, r.measured, r.measuredOn, r.assumptions, r.item.row, r.item['Source ID']];
  },

  summarize(ranked) {
    const sum = key => ranked.reduce((n, r) => n + (r[key] || 0), 0);
    return { count: ranked.length, current: sum('hours'), potential: sum('saved'), annual: sum('annual'),
      measured: ranked.some(r => r.measured !== null) ? sum('measured') : null,
      measuredCount: ranked.filter(r => r.measured !== null).length,
      top: ranked.filter(r => r.saved > 0 && r.status !== 'Live' && r.status !== 'Paused').slice(0, 3) };
  },
};

/** @customfunction */
function WEEKLY_WORK_HOURS(runs, minutes, people, errorRate, reworkMinutes) {
  return Backlog.number(runs, 'Runs/week', 0, 100000) *
    (Backlog.number(minutes, 'Minutes/run', 0, 10080) * Backlog.number(people, 'People/run', 1, 10000, 1) +
    Backlog.number(errorRate, 'Error rate %', 0, 100, 0) / 100 * Backlog.number(reworkMinutes, 'Rework min/error', 0, 10080, 0)) / 60;
}

const Settings = {
  HEADERS: ['Setting', 'Value', 'What this means'],
  DEFAULTS: [
    ['Data source', 'Demo', 'Demo uses fictional rows. My backlog uses your Backlog tab and imports your Form submissions when you rank.'],
    ['Create Google files', 'No', 'No previews everything inside this workbook. Yes lets menu actions create an intake Form and report Doc.'],
    ['Hourly cost', 45, 'Blended cost per staff hour, in your own currency. This estimates capacity value, not cash savings.'],
    ['Working weeks/year', 48, 'Working weeks used to annualize potential savings.'],
    ['Default build hours', 8, 'Used only when a Backlog row has no Build hours estimate.'],
    ['Default deletion hours', 0.5, 'Time to retire an unnecessary process, used when Build hours is blank.'],
  ],

  read() {
    const rows = Book.read('Settings', Settings.HEADERS);
    const values = {};
    rows.forEach(row => {
      if (!row[0] && !row[1]) return;
      if (!Settings.DEFAULTS.some(r => r[0] === row[0])) throw new OperatorError('Settings has an unknown setting. Restore its labels using the operator guide.');
      if (Object.prototype.hasOwnProperty.call(values, row[0])) throw new OperatorError('Settings has a duplicate setting: ' + row[0] + '. Keep one of each.');
      values[row[0]] = row[1];
    });
    const source = Backlog.choice(values['Data source'], 'Data source in Settings', ['Demo', 'My backlog']);
    const files = Backlog.choice(values['Create Google files'], 'Create Google files in Settings', ['No', 'Yes']);
    return { source, files: files === 'Yes', hourlyCost: Backlog.number(values['Hourly cost'], 'Hourly cost in Settings', 0, 100000),
      weeksPerYear: Backlog.number(values['Working weeks/year'], 'Working weeks/year in Settings', 1, 52),
      defaultBuildHours: Backlog.number(values['Default build hours'], 'Default build hours in Settings', 0.01, 100000),
      deleteHours: Backlog.number(values['Default deletion hours'], 'Default deletion hours in Settings', 0.01, 100000) };
  },

  initialize() {
    const sh = Book.sheet('Settings', Settings.HEADERS);
    const rows = Book.read('Settings', Settings.HEADERS);
    const missing = Settings.DEFAULTS.filter(def => !rows.some(row => row[0] === def[0]));
    Book.append('Settings', Settings.HEADERS, missing);
    const all = Book.read('Settings', Settings.HEADERS);
    all.forEach((row, i) => {
      const cell = sh.getRange(i + 2, 2);
      cell.setBackground('#fff2cc');
      const choices = row[0] === 'Data source' ? ['Demo', 'My backlog'] : row[0] === 'Create Google files' ? ['No', 'Yes'] : null;
      cell.setDataValidation(choices ? SpreadsheetApp.newDataValidation().requireValueInList(choices, true).setAllowInvalid(false).build() :
        SpreadsheetApp.newDataValidation().requireNumberBetween(row[0] === 'Hourly cost' ? 0 : row[0] === 'Working weeks/year' ? 1 : 0.01, row[0] === 'Working weeks/year' ? 52 : 100000).setAllowInvalid(false).build());
      cell.setNote(String(row[2]));
    });
    return sh;
  },

  requireFiles() {
    const opts = Settings.read();
    if (!opts.files) throw new OperatorError('Preview mode is on. To create a Form or Doc, set Settings → Create Google files to Yes, then run this action again.');
    if (opts.source === 'Demo') throw new OperatorError('Choose My backlog in Settings before creating files. The demo stays inside this workbook.');
    return opts;
  },

  chooseSource(value) {
    Backlog.choice(value, 'Data source', ['Demo', 'My backlog']);
    const rows = Book.read('Settings', Settings.HEADERS);
    const index = rows.findIndex(row => row[0] === 'Data source');
    if (index < 0) throw new OperatorError('Run Set up workbook before choosing a data source.');
    Book.open().getSheetByName('Settings').getRange(index + 2, 2).setValue(value);
  },
};

