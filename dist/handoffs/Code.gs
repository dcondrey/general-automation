class OperatorError extends Error {}

const Book = {
  MAX_ROWS: 2000,
  MAX_TEXT: 2000,

  open() {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    if (!ss) throw new OperatorError('Open the Discovery workbook and use its Automations menu.');
    return ss;
  },

  sheet(name, headers) {
    const ss = Book.open();
    let sh = ss.getSheetByName(name);
    if (!sh) sh = ss.insertSheet(name);
    if (headers) {
      if (sh.getLastRow() === 0) {
        Book.put(sh.getRange(1, 1, 1, headers.length), [headers]);
      } else {
        const actual = sh.getRange(1, 1, 1, Math.max(sh.getLastColumn(), headers.length)).getValues()[0];
        if (actual.length !== headers.length || actual.some((h, i) => h !== headers[i])) {
          throw new OperatorError('The column headings in "' + name + '" changed. Restore them from the operator guide before continuing; your rows have been kept.');
        }
      }
    }
    return sh;
  },

  safeCell(value) {
    if (typeof value === 'string') {
      if (value.length > Book.MAX_TEXT) throw new OperatorError('A text value exceeds 2,000 characters. Shorten it before continuing.');
      return /^[\s\u0000-\u001f]*[=+@\-]/.test(value) ? "'" + value : value;
    }
    return value === undefined || value === null ? '' : value;
  },

  put(range, rows) {
    range.setValues(rows.map(row => row.map(Book.safeCell)));
  },

  read(name, headers) {
    const sh = Book.sheet(name, headers);
    if (sh.getLastRow() > Book.MAX_ROWS + 1) throw new OperatorError('"' + name + '" exceeds 2,000 rows. Archive older rows in a separate workbook first.');
    return sh.getLastRow() < 2 ? [] : sh.getRange(2, 1, sh.getLastRow() - 1, headers.length).getValues();
  },

  replace(name, headers, rows) {
    if (rows.length > Book.MAX_ROWS) throw new OperatorError('This operation exceeds the 2,000-row limit.');
    const sh = Book.sheet(name, headers);
    const values = [headers].concat(rows).map(row => row.map(Book.safeCell));
    Book.ensureRows(sh, values.length);
    const previous = sh.getLastRow();
    sh.getRange(1, 1, values.length, headers.length).setValues(values);
    if (previous > values.length) sh.getRange(values.length + 1, 1, previous - values.length, headers.length).clearContent();
    return sh;
  },

  ensureRows(sh, count) {
    if (count > sh.getMaxRows()) sh.insertRowsAfter(sh.getMaxRows(), count - sh.getMaxRows());
  },

  append(name, headers, rows) {
    if (!rows.length) return;
    const sh = Book.sheet(name, headers);
    const end = sh.getLastRow() + rows.length;
    if (end > Book.MAX_ROWS + 1) throw new OperatorError('"' + name + '" would exceed 2,000 rows. Archive older rows first.');
    Book.ensureRows(sh, end);
    Book.put(sh.getRange(sh.getLastRow() + 1, 1, rows.length, headers.length), rows);
  },

  state(key, value) {
    const props = PropertiesService.getDocumentProperties();
    if (!props) throw new OperatorError('Install this script inside a Google spreadsheet.');
    // Copied containers must never reuse the original workbook's Form or Doc.
    const scoped = Book.open().getId() + ':' + key;
    if (value !== undefined) props.setProperty(scoped, String(value));
    return props.getProperty(scoped);
  },

  locked(fn) {
    const lock = LockService.getDocumentLock();
    if (!lock || !lock.tryLock(1000)) throw new OperatorError('Another automation is running. Wait a moment, then try again.');
    try { return fn(); } finally { lock.releaseLock(); }
  },
};

const RunLog = {
  HEADERS: ['Started', 'Action', 'Status', 'Seconds', 'What happened'],

  record(name, started, status, detail) {
    const sh = Book.sheet('Run log', RunLog.HEADERS);
    if (sh.getLastRow() > 501) sh.deleteRows(2, sh.getLastRow() - 501);
    Book.append('Run log', RunLog.HEADERS, [[new Date(started), name, status, (Date.now() - started) / 1000, detail.slice(0, 500)]]);
  },

  run(name, fn) {
    const started = Date.now();
    let result;
    try {
      result = Book.locked(fn);
    } catch (error) {
      try { Book.locked(() => RunLog.record(name, started, 'Needs attention', 'Action stopped. Use Fix setup problems and check Issues.')); }
      catch (_) { console.error('Could not record the failed action. Check workbook access.'); }
      throw error;
    }
    try { Book.locked(() => RunLog.record(name, started, 'Done', result && result.summary || 'Completed.')); }
    catch (_) {
      throw new OperatorError('The action completed, but the Run log could not be updated. Check the results before retrying; restore Run log headings if they changed.');
    }
    return result;
  },
};

function operatorAction_(name, fn) {
  try {
    const result = RunLog.run(name, fn);
    Book.open().toast(result.summary, 'Automations', 10);
    return result;
  } catch (error) {
    const message = error instanceof OperatorError ? error.message :
      'This action could not finish. Check Settings, Run log, Google permissions, and workbook access. If it persists, ask the workbook owner to inspect Apps Script → Executions.';
    SpreadsheetApp.getUi().alert('Automations needs attention', message, SpreadsheetApp.getUi().ButtonSet.OK);
    return { error: message };
  }
}

const Suite = {
  table(name, headers, seed) {
    const sh = Book.sheet(name, headers);
    Book.ensureRows(sh, Book.MAX_ROWS + 1);
    if (seed && sh.getLastRow() === 1) Book.append(name, headers, seed);
    sh.setFrozenRows(1);
    sh.getRange(1, 1, 1, headers.length).setBackground('#15213d').setFontColor('#ffffff').setFontWeight('bold').setWrap(true);
    sh.setColumnWidths(1, headers.length, 155);
    return sh;
  },
  settings(defaults) {
    Suite.table('Settings', ['Setting', 'Value', 'Help']);
    const existing = Book.read('Settings', ['Setting', 'Value', 'Help']);
    Book.append('Settings', ['Setting', 'Value', 'Help'], defaults.filter(r => !existing.some(e => e[0] === r[0])));
    const sh = Book.open().getSheetByName('Settings');
    sh.getRange(2, 2, defaults.length, 1).setBackground('#fff2cc');
    sh.setColumnWidth(3, 650);
    sh.getRange(2, 2).setDataValidation(SpreadsheetApp.newDataValidation().requireValueInList(['Demo', 'Live'], true).setAllowInvalid(false).build());
    return Suite.options();
  },
  options() {
    const result = Object.create(null);
    Book.read('Settings', ['Setting', 'Value', 'Help']).forEach(row => {
      if (Object.prototype.hasOwnProperty.call(result, row[0])) throw new OperatorError('Settings has a duplicate label: ' + row[0]);
      result[row[0]] = row[1];
    });
    if (!['Demo', 'Live'].includes(result.Mode)) throw new OperatorError('Choose Demo or Live in Settings → Mode.');
    return result;
  },
  number(v, name, min, max) {
    if ((typeof v !== 'number' && (typeof v !== 'string' || !/^\d+(\.\d+)?$/.test(v.trim()))) || !Number.isFinite(Number(v)) || Number(v) < min || Number(v) > max) {
      throw new OperatorError(name + ' must be a number from ' + min + ' to ' + max + '.');
    }
    return Number(v);
  },
  text(v, name, max) {
    if (typeof v !== 'string' || !v.trim() || v.length > max) throw new OperatorError(name + ' is required and must be at most ' + max + ' characters.');
    return v.trim();
  },
  date(v, name) {
    if (v instanceof Date && Number.isFinite(v.getTime())) return v;
    if (typeof v === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(v)) {
      const d = new Date(v + 'T00:00:00Z');
      if (Number.isFinite(d.getTime()) && d.toISOString().slice(0, 10) === v) return d;
    }
    throw new OperatorError(name + ' must be a date in YYYY-MM-DD format.');
  },
  hash(text) {
    return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, text, Utilities.Charset.UTF_8).map(b => ('0' + ((b + 256) % 256).toString(16)).slice(-2)).join('');
  },
  help(title, rows) {
    Suite.table('Start here', ['Step', 'What to do']);
    Book.replace('Start here', ['Step', 'What to do'], [[title, 'Start in Demo. Yellow Settings values control this workbook.'], ...rows]);
    Book.open().getSheetByName('Start here').setColumnWidth(2, 850);
  },
};

const Connections = {
  NAMES: ['Slack webhook', 'Gemini API key', 'Asana token'],
  get(name, optional) {
    const value = PropertiesService.getUserProperties().getProperty(Book.open().getId() + ':' + name);
    if (!value && !optional) throw new OperatorError('Choose Automations → Connections and save your ' + name + '.');
    return value || '';
  },
  save(name, value) {
    if (!Connections.NAMES.includes(name) || typeof value !== 'string' || value.length < 10 || value.length > 1000 || /[\r\n\u0000]/.test(value)) throw new OperatorError('Select a supported connection and enter a valid credential.');
    if (name === 'Slack webhook' && !/^https:\/\/hooks\.slack\.com\/services\/[A-Za-z0-9_\/-]+$/.test(value)) throw new OperatorError('Use a Slack incoming webhook URL beginning https://hooks.slack.com/services/.');
    PropertiesService.getUserProperties().setProperty(Book.open().getId() + ':' + name, value);
    return 'Saved for your Google login and this workbook. Other editors enter their own credentials.';
  },
};
function showConnections() { SpreadsheetApp.getUi().showSidebar(HtmlService.createHtmlOutputFromFile('Connections').setTitle('Connections')); }
function saveConnection(name, value) { return Connections.save(name, value); }

const Transport = {
  request(url, method, body, headers, retryReads) {
    if (!/^https:\/\/(app\.asana\.com\/api\/1\.0\/|generativelanguage\.googleapis\.com\/v1beta\/models\/|hooks\.slack\.com\/services\/)/.test(url)) throw new OperatorError('This connection endpoint is not supported.');
    const opts = { method: method || 'get', muteHttpExceptions: true, headers: headers || {}, followRedirects: false };
    if (body !== undefined) Object.assign(opts, { contentType: 'application/json', payload: JSON.stringify(body) });
    for (let attempt = 0; attempt < 3; attempt++) {
      let response;
      try { response = UrlFetchApp.fetch(url, opts); }
      catch (_) { throw new OperatorError('The connection ended without a confirmed result. Check the destination before retrying a write.'); }
      const code = response.getResponseCode();
      if (code >= 200 && code < 300) {
        const text = response.getContentText();
        if (text.length > 2000000) throw new OperatorError('The service returned too much data. Narrow the request before trying again.');
        return text;
      }
      if (opts.method === 'get' && retryReads && attempt < 2 && (code === 429 || code >= 500)) {
        const all = response.getAllHeaders();
        const key = Object.keys(all).find(k => k.toLowerCase() === 'retry-after');
        const retry = key ? Number(all[key]) : NaN;
        const wait = Number.isFinite(retry) && retry >= 0 ? retry * 1000 : 1000 * Math.pow(2, attempt);
        if (wait > 10000) throw new OperatorError('The service is rate limited. Wait before trying again.');
        Utilities.sleep(wait);
        continue;
      }
      throw new OperatorError(code === 401 || code === 403 ? 'The service rejected this connection. Check your token and access in Connections.' : 'The service returned status ' + code + '. Check the destination before retrying a write.');
    }
  },
  json(url, method, body, headers, retryReads) {
    const text = Transport.request(url, method, body, headers, retryReads);
    try { return JSON.parse(text); } catch (_) { throw new OperatorError('The service returned an unreadable result. Check the destination before retrying.'); }
  },
};

const Handoffs = {
  INPUT: ['Handoff key', 'Source Asana task ID', 'Ready? (Yes/No)', 'Next team', 'Task name', 'Project ID', 'Assignee ID', 'Due on', 'SKU', 'ASIN', 'Asset URL', 'Brief'],
  LEDGER: ['Handoff key', 'Fingerprint', 'State', 'Asana task ID', 'Started', 'What to do'],
  defaults: [['Mode', 'Demo', 'Demo validates fictional rows without contacting Asana. Live requires your Asana token.']],
  samples: [['demo-handoff-1', '', 'Yes', 'Catalog', 'Prepare updated product listing', '123456789', '', '', 'DEMO-PET', 'B000000001', 'https://example.com/demo-assets', 'Fictional package dimensions are ready.']],
  gid(v, name, optional) {
    if (optional && v === '') return '';
    if (typeof v !== 'string' || !/^\d{1,40}$/.test(v)) throw new OperatorError(name + ' must be a numeric ID stored as plain text, not a rounded spreadsheet number.');
    return v;
  },
  plan(row) {
    const key = Suite.text(row[0], 'Handoff key', 100);
    if (!/^[A-Za-z0-9_.:-]+$/.test(key)) throw new OperatorError('Handoff key may contain letters, digits, underscores, periods, colons, and hyphens.');
    const source = Handoffs.gid(row[1], 'Source task ID', true);
    if (!['Yes', 'No'].includes(row[2])) throw new OperatorError('Ready? must be Yes or No.');
    const team = Suite.text(row[3], 'Next team', 80), name = Suite.text(row[4], 'Task name', 160), project = Handoffs.gid(row[5], 'Project ID'), assignee = Handoffs.gid(row[6], 'Assignee ID', true);
    const due = row[7] === '' ? '' : Suite.date(row[7], 'Due on').toISOString().slice(0, 10);
    const sku = Suite.text(row[8], 'SKU', 64), asin = Suite.text(row[9], 'ASIN', 10), asset = Suite.text(row[10], 'Asset URL', 500), brief = Suite.text(row[11], 'Brief', 1000);
    if (!/^[A-Z0-9]{10}$/.test(asin)) throw new OperatorError('ASIN must contain exactly 10 uppercase letters or digits.');
    if (!/^https:\/\/[^\s/]+\//.test(asset)) throw new OperatorError('Asset URL must be a complete HTTPS link.');
    const notes = 'Automation handoff key: ' + key + '\nNext team: ' + team + '\nSKU: ' + sku + '\nASIN: ' + asin + '\nAssets: ' + asset + '\n\n' + brief;
    const payload = { data: { name, notes, projects: [project] } };
    if (assignee) payload.data['assignee'] = assignee;
    if (due) payload.data['due_on'] = due;
    return { key, source, ready: row[2] === 'Yes', project, payload };
  },
  setup() {
    Suite.settings(Handoffs.defaults);
    Suite.table('Handoffs', Handoffs.INPUT);
    Suite.table('Demo handoffs', Handoffs.INPUT, Handoffs.samples);
    Suite.table('Handoff ledger', Handoffs.LEDGER);
    Suite.table('Preview', ['Handoff key', 'Decision', 'Task name', 'Inputs and next action']);
    [1, 2, 6, 7].forEach(c => Book.open().getSheetByName('Handoffs').getRange(2, c, Book.MAX_ROWS, 1).setNumberFormat('@'));
    Book.open().getSheetByName('Handoffs').getRange(2, 3, Book.MAX_ROWS, 1).setDataValidation(SpreadsheetApp.newDataValidation().requireValueInList(['Yes', 'No'], true).setAllowInvalid(false).build());
    Suite.help('Team Handoffs', [['1. Try demo', 'Run handoffs validates the fictional handoff and fills Preview. Demo never calls Asana.'], ['2. Define a handoff', 'Complete one Handoffs row, including key, destination project, owner inputs, SKU, ASIN, assets, and brief. Project/task/assignee IDs are plain text.'], ['3. Gate the transfer', 'Ready? must be Yes. If a source Asana task ID is present, the task must also be complete in Asana.'], ['4. Run live', 'Save an Asana personal token in Connections, choose Live, and Run handoffs. At most five new destination tasks are created per run.'], ['5. Recover safely', 'A started request is recorded as Unknown before sending. Unknown never retries automatically. Reconcile checks the destination project for the exact handoff marker.'], ['6. Change a task', 'A completed handoff key is immutable. Edit the existing Asana task deliberately or create a new unique handoff key for a genuinely new transfer.']]);
    return Suite.options().Mode === 'Demo' ? Handoffs.run() : { summary: 'Setup is ready. Choose Run handoffs explicitly when ready to create destination tasks.' };
  },
  run() {
    const demo = Suite.options().Mode === 'Demo';
    const plans = Book.read(demo ? 'Demo handoffs' : 'Handoffs', Handoffs.INPUT).map(Handoffs.plan);
    if (new Set(plans.map(p => p.key)).size !== plans.length) throw new OperatorError('Each handoff key must be unique.');
    const ledger = Book.read('Handoff ledger', Handoffs.LEDGER), byKey = new Map();
    ledger.forEach(r => { if (byKey.has(r[0])) throw new OperatorError('Handoff ledger contains a duplicate key. Restore one ledger row per handoff.'); byKey.set(r[0], r); });
    const previews = [], token = demo ? '' : Connections.get('Asana token');
    let created = 0;
    for (const plan of plans) {
      const fingerprint = Suite.hash(JSON.stringify([plan.source, plan.payload]));
      const prior = byKey.get(plan.key);
      if (prior) {
        previews.push([plan.key, prior[1] !== fingerprint ? 'Changed after send — review' : prior[2], plan.payload.data.name, prior[1] !== fingerprint ? 'The same key has different inputs. Edit the existing Asana task or use a new key for new work.' : prior[5]]);
        continue;
      }
      if (!plan.ready) { previews.push([plan.key, 'Waiting', plan.payload.data.name, 'Ready? is No.']); continue; }
      if (demo) { previews.push([plan.key, 'Would create', plan.payload.data.name, plan.payload.data.notes]); continue; }
      if (created >= 5) { previews.push([plan.key, 'Next run', plan.payload.data.name, 'Five new tasks per run limit.']); continue; }
      const headers = { Authorization: 'Bearer ' + token };
      if (plan.source) {
        const source = Transport.json('https://app.asana.com/api/1.0/tasks/' + plan.source + '?opt_fields=completed', 'get', undefined, headers, true);
        if (source.data?.completed !== true) { previews.push([plan.key, 'Waiting', plan.payload.data.name, 'Source Asana task is not confirmed complete.']); continue; }
      }
      const row = [plan.key, fingerprint, 'Unknown', '', new Date(), 'Check destination before retrying; use Reconcile unknown handoffs.'];
      Book.append('Handoff ledger', Handoffs.LEDGER, [row]); ledger.push(row); byKey.set(plan.key, row);
      const response = Transport.json('https://app.asana.com/api/1.0/tasks', 'post', plan.payload, headers);
      const id = Handoffs.gid(response.data?.gid, 'Created task ID');
      row[2] = 'Created'; row[3] = id; row[5] = 'https://app.asana.com/0/' + plan.project + '/' + id;
      Book.replace('Handoff ledger', Handoffs.LEDGER, ledger);
      previews.push([plan.key, 'Created', plan.payload.data.name, row[5]]); created++;
    }
    Book.replace('Preview', ['Handoff key', 'Decision', 'Task name', 'Inputs and next action'], previews);
    return { summary: (demo ? 'DEMO: ' : '') + previews.length + ' handoffs checked; ' + created + ' tasks created. Unknown writes remain held for reconciliation.' };
  },
  reconcile() {
    if (Suite.options().Mode !== 'Live') throw new OperatorError('Reconciliation runs only in Live mode.');
    const plans = Book.read('Handoffs', Handoffs.INPUT).map(Handoffs.plan), ledger = Book.read('Handoff ledger', Handoffs.LEDGER);
    const headers = { Authorization: 'Bearer ' + Connections.get('Asana token') };
    for (const row of ledger.filter(r => r[2] === 'Unknown')) {
      const plan = plans.find(p => p.key === row[0]);
      if (!plan) continue;
      if (Suite.hash(JSON.stringify([plan.source, plan.payload])) !== row[1]) { row[5] = 'Inputs changed after an uncertain send. Restore the original inputs before reconciliation; write remains held.'; continue; }
      let url = 'https://app.asana.com/api/1.0/projects/' + plan.project + '/tasks?limit=100&opt_fields=gid,notes', matches = [], complete = false;
      for (let page = 0; page < 10; page++) {
        const response = Transport.json(url, 'get', undefined, headers, true);
        if (!Array.isArray(response.data)) throw new OperatorError('Asana returned an invalid task list. Reconciliation stopped without releasing the held write.');
        matches = matches.concat(response.data.filter(t => typeof t.notes === 'string' && t.notes.split('\n').includes('Automation handoff key: ' + plan.key)));
        const offset = response.next_page?.offset;
        if (!offset) { complete = true; break; }
        if (typeof offset !== 'string' || offset.length > 500) throw new OperatorError('Asana returned an invalid pagination cursor.');
        url = 'https://app.asana.com/api/1.0/projects/' + plan.project + '/tasks?limit=100&opt_fields=gid,notes&offset=' + encodeURIComponent(offset);
      }
      if (matches.length === 1 && complete) { row[2] = 'Reconciled'; row[3] = Handoffs.gid(matches[0].gid, 'Reconciled task ID'); row[5] = 'https://app.asana.com/0/' + plan.project + '/' + row[3]; }
      else row[5] = !complete ? 'Search exceeded 1,000 tasks. Inspect the destination manually; write remains held.' : matches.length > 1 ? 'Multiple matching tasks. Resolve duplicates manually; write remains held.' : 'No matching task found. Confirm eventual visibility and permissions manually before deciding whether a new transfer is needed.';
    }
    Book.replace('Handoff ledger', Handoffs.LEDGER, ledger);
    return { summary: 'Unknown handoffs checked. No task was created or automatically released for retry.' };
  },
  menu() { SpreadsheetApp.getUi().createMenu('Automations').addItem('Set up workbook', 'handoffSetup').addItem('Run handoffs', 'handoffRun').addItem('Reconcile unknown handoffs', 'handoffReconcile').addItem('Connections', 'showConnections').addToUi(); },
};
function handoffSetup() { return operatorAction_('Set up Team Handoffs', Handoffs.setup); }
